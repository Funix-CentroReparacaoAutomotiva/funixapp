# VPS only: /etc/funix/runtime.env, root:root, mode 0600.
# Compose >= 2.30 reads this as raw: do not wrap values in quotes.
# Never commit the real file. Use a strong unique password (12–256 characters).
FUNIX_OPERATOR_PASSWORD=
# Optional until live Coda read access is provisioned and verified.
CODA_API_TOKEN=
FUNIX_CODA_FUNIL_VIEW_ID=
FUNIX_CODA_ACOMPANHAMENTO_VIEW_ID=
