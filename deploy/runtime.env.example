# VPS only: /etc/funix/runtime.env, root:root, mode 0600.
# Compose >= 2.30 reads this as raw: do not wrap values in quotes.
# Never commit the real file. Use a strong unique password (12–256 characters).
FUNIX_OPERATOR_PASSWORD=
# Optional until live Coda read access is provisioned and verified.
CODA_API_TOKEN=
FUNIX_CODA_FUNIL_VIEW_ID=
FUNIX_CODA_ACOMPANHAMENTO_VIEW_ID=

# Backend-only PDF renderer. Required to issue NEW budgets; historical PDFs stay readable.
# Use the existing authenticated HTTPS endpoint ending in /api/report.
FUNIX_JSREPORT_ENDPOINT=
FUNIX_JSREPORT_USERNAME=
FUNIX_JSREPORT_PASSWORD=
FUNIX_JSREPORT_TEMPLATE=FUNIX - Orcamento

# Cotação de peças — somente para o app de testes, desabilitada por padrão.
# Não habilite sem autorização explícita e orçamento de até 10 buscas.
# A API usa a OPENAI_API_KEY configurada no backend por meio do cofre.
# FUNIX_QUOTE_ENABLED=false
# FUNIX_QUOTE_LEDGER=/data/funix-quote-pilot-ledger.json
