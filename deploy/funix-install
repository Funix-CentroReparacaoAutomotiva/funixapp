#!/bin/bash
# One-time preparation only. Run a reviewed, pinned checkout as root.
set +x
set -Eeuo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
unset DOCKER_HOST DOCKER_CONTEXT DOCKER_TLS DOCKER_TLS_VERIFY DOCKER_CERT_PATH COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONFIG
die() { printf '%s\n' "$1" >&2; exit 1; }
[[ $(id -u) == 0 && $# == 0 ]] || die 'Uso: sudo bash deploy/funix-install (sem argumentos).'
src=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
for tool in docker python3 ssh-keygen useradd passwd visudo install stat flock; do
  command -v "$tool" >/dev/null || die "Pré-requisito ausente: $tool. Nada será instalado automaticamente."
done
[[ $(uname -m) == x86_64 ]] || die 'As imagens exigem amd64.'
# Validate all ancestors before creating anything. Never follow existing symlinks.
for parent in /run /opt /etc /var /var/lib /home /usr /usr/local /usr/local/sbin /etc/sudoers.d; do
  [[ -d $parent && ! -L $parent && $(stat -c %u "$parent") == 0 ]] || die "Diretório inseguro: $parent"
  mode=$(stat -c %a "$parent")
  (( (8#$mode & 022) == 0 )) || die "Diretório gravável por terceiros: $parent"
done
# /run is root-controlled; refuse an unexpected preexisting lock object.
lock=/run/funixapp-install.lock
if [[ -e $lock || -L $lock ]]; then
  [[ -f $lock && ! -L $lock && $(stat -c %u "$lock") == 0 ]] || die 'Lock FUNIX inseguro.'
  mode=$(stat -c %a "$lock")
  (( (8#$mode & 022) == 0 )) || die 'Lock FUNIX gravável por terceiros.'
fi
exec 9>"$lock"
flock -n 9 || die 'Outro instalador FUNIX está em andamento.'
for dest in /opt/funix /etc/funix /var/lib/funix /home/funix-deploy /usr/local/sbin/funix-deploy /usr/local/sbin/funix-ssh /etc/sudoers.d/funix-deploy; do
  [[ ! -e $dest && ! -L $dest ]] || die "Instalação inicial recusada: $dest já existe. Não sobrescrito."
done
if getent passwd funix-deploy >/dev/null || getent group funix-deploy >/dev/null; then
  die 'Usuário/grupo funix-deploy já existe; nenhuma conta será reaproveitada.'
fi
for file in compose.yaml deploy/funix-deploy deploy/funix-ssh deploy/funix-deploy.sudoers deploy/runtime.env.example deploy/check-install.py; do
  [[ -f $src/$file && ! -L $src/$file ]] || die "Arquivo ausente/inválido: $file"
done
bash -n "$src/deploy/funix-deploy" "$src/deploy/funix-ssh"
visudo -c >/dev/null
visudo -cf "$src/deploy/funix-deploy.sudoers" >/dev/null
docker=(docker --host=unix:///var/run/docker.sock)
version=$("${docker[@]}" compose version --short)
version=${version#v}
[[ $(printf '%s\n' 2.30.0 "$version" | sort -V | head -n1) == 2.30.0 ]] || die 'Compose >= 2.30 necessário; Docker não será atualizado.'
"${docker[@]}" network inspect traefik_default >/dev/null 2>&1 || die 'Rede traefik_default ausente; não será criada.'
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
ids=$("${docker[@]}" ps -aq)
if [[ -n $ids ]]; then
  # Docker IDs are generated hex strings, never caller-supplied arguments.
  "${docker[@]}" inspect --format '{{json .Config.Labels}}' $ids > "$stage/containers.json"
else
  printf '' > "$stage/containers.json"
fi
python3 "$src/deploy/check-install.py" "$stage/containers.json"
read -r -p 'Cole a chave PÚBLICA Ed25519 dedicada ao Actions: ' public_key
[[ $public_key =~ ^ssh-ed25519\ [A-Za-z0-9+/=]+(\ .*)?$ && $public_key != *$'\r'* ]] || die 'Chave pública Ed25519 inválida (sem opções SSH).'
printf '%s\n' "$public_key" > "$stage/key.pub"
ssh-keygen -lf "$stage/key.pub" >/dev/null 2>&1 || die 'Chave pública inválida.'
read -r -s -p 'Senha do operador FUNIX (12–256 caracteres): ' password; printf '\n'
read -r -s -p 'Confirme a senha: ' confirmation; printf '\n'
[[ ${#password} -ge 12 && ${#password} -le 256 && $password == "$confirmation" && $password != *$'\r'* ]] || die 'Senha inválida ou confirmação diferente.'
printf 'FUNIX_OPERATOR_PASSWORD=%s\nCODA_API_TOKEN=\nFUNIX_CODA_FUNIL_VIEW_ID=\nFUNIX_CODA_ACOMPANHAMENTO_VIEW_ID=\n' "$password" > "$stage/runtime.env"
unset password confirmation
read -r -p 'Login GitHub da conta com leitura dos dois packages GHCR: ' registry_user
[[ $registry_user =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die 'Login GitHub inválido.'
read -r -s -p 'Token GHCR somente read:packages: ' registry_token; printf '\n'
[[ -n $registry_token ]] || die 'Token vazio.'
mkdir "$stage/registry"
printf '%s' "$registry_token" | "${docker[@]}" --config "$stage/registry" login ghcr.io --username "$registry_user" --password-stdin >/dev/null 2>&1 || die 'Login GHCR falhou; nenhum arquivo permanente instalado.'
unset registry_token
[[ -f $stage/registry/config.json ]] || die 'Credencial GHCR não foi persistida no estágio privado.'
# Validate the exact Compose with a temporary runtime path; never start/pull.
sed "s|/etc/funix/runtime.env|$stage/runtime.env|" "$src/compose.yaml" > "$stage/compose.yaml"
FUNIX_RELEASE=preparation FUNIX_API_IMAGE=funix-api:preparation FUNIX_WEB_IMAGE=funix-web:preparation \
  "${docker[@]}" compose --project-name funixapp --file "$stage/compose.yaml" config --quiet
# All preflight/input checks above precede persistent installation.
install -d -o root -g root -m 0755 /opt/funix
install -d -o root -g root -m 0700 /etc/funix /etc/funix/registry /var/lib/funix /var/lib/funix/releases
install -o root -g root -m 0644 "$src/compose.yaml" /opt/funix/compose.yaml
install -o root -g root -m 0755 "$src/deploy/funix-deploy" /usr/local/sbin/funix-deploy
install -o root -g root -m 0755 "$src/deploy/funix-ssh" /usr/local/sbin/funix-ssh
install -o root -g root -m 0600 "$stage/runtime.env" /etc/funix/runtime.env
install -o root -g root -m 0600 "$stage/registry/config.json" /etc/funix/registry/config.json
mkdir "$stage/empty-home"
useradd --skel "$stage/empty-home" -G '' -K CREATE_MAIL_SPOOL=no --create-home --user-group --shell /bin/bash funix-deploy
passwd -l funix-deploy >/dev/null
chown root:root /home/funix-deploy
chmod 0755 /home/funix-deploy
install -d -o root -g root -m 0755 /home/funix-deploy/.ssh
printf 'restrict,command="/usr/local/sbin/funix-ssh" %s\n' "$public_key" > "$stage/authorized_keys"
install -o root -g root -m 0644 "$stage/authorized_keys" /home/funix-deploy/.ssh/authorized_keys
install -o root -g root -m 0440 "$src/deploy/funix-deploy.sudoers" /etc/sudoers.d/funix-deploy
printf '%s\n' 'Preparação concluída. Nenhum contêiner iniciado. Mantenha FUNIX_DEPLOY_ENABLED=false.'
