        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const seen=new Set(),out=[];\nconst plateRe=/(?:^|[^A-Z0-9])([A-Z]{3})[-\\s]?([0-9])([A-Z0-9])([0-9]{2})(?=$|[^A-Z0-9])/g;\nconst xpRe=/\\bXP\\s*[-#:]?\\s*([0-9]{3,8})\\b/gi;\nfor(const item of $input.all()){\n const src=item.json??{},messageId=String(src.id??'').trim();\n if(!/^[a-f0-9]{15,25}$/i.test(messageId)||seen.has(messageId))continue;\n seen.add(messageId);\n const subject=String(src.Subject??src.subject??'').slice(0,1000).toUpperCase();\n const plates=new Set(),xps=new Set();let m;\n plateRe.lastIndex=0;while((m=plateRe.exec(subject))!==null)plates.add(m[1]+m[2]+m[3]+m[4]);\n xpRe.lastIndex=0;while((m=xpRe.exec(subject))!==null)xps.add('XP'+m[1]);\n const ambiguous=plates.size>1||xps.size>1;\n out.push({json:{\n  messageId,source:'gmail',plateHint:plates.size===1?[...plates][0]:null,\n  xpHint:xps.size===1?[...xps][0]:null,\n  identitySignalStatus:ambiguous?'AMBIGUOUS_HINTS':plates.size||xps.size?'UNVERIFIED_HINTS':'NO_HINTS',\n  requiresCodaVerification:true,requiresDocumentReview:true,requiresCommercialReview:true,\n  sendEnabled:false,archiveEnabled:false\n }});\n}\nreturn out;"
