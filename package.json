{
  "name": "funixapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:api": "node --use-env-proxy --watch --env-file-if-exists=.env server/index.ts",
    "check:server": "tsc -p server/tsconfig.json",
    "test:server": "node --test --test-isolation=none --test-reporter=spec server/tests/*.test.ts",
    "check": "npm run build && npm run check:server && npm run test:server && npm run lint"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.9.0"
}
