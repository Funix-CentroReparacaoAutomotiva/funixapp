            "language": "javaScript",
            "jsCode": "// eslint-disable-next-line no-unused-vars -- Concatenated with the receipt/ACK Code-node sources by build-plan.mjs.\nfunction readBody(response) {\n  const body = response.body;\n  if (body && typeof body === 'object' && !body._readableState) return body;\n  // Preserve the bounded response representation already handled by the published nodes.\n  const chunks = body?._readableState?.buffer;\n  const chunk = Array.isArray(chunks) ? chunks.find(x => x?.type === 'Buffer' && Array.isArray(x.data)) : null;\n  if (chunk && chunk.data.length <= 8192) {\n    try { return JSON.parse(String.fromCharCode(...chunk.data)); } catch { return null; }\n  }\n  return null;\n}\nconst expected = $('Preparar uma entrega ou conciliacao').item.json;\nconst response = $input.first()?.json ?? {};\nconst status = Number(response.statusCode ?? 0);\nconst body = readBody(response);\n// Invalid/uncertain responses never advance delivery state. Preserve only a fixed error code.\nconst valid = status === 200 && body && typeof body === 'object' &&\n  body.messageId === expected.messageId &&\n  ['queued', 'leased', 'retry', 'notified', 'ignored', 'blocked'].includes(body.state);\nreturn [{json: {\n  messageId: expected.messageId,\n  expectedState: expected.expectedState,\n  expectedLastError: expected.expectedLastError,\n  queueState: valid ? body.state : expected.expectedState,\n  lastError: ['INTEGRATION_AUTH_INTAKE','INTEGRATION_ROUTE_INTAKE'].includes(expected.expectedLastError) ? expected.expectedLastError :\n    valid ? (body.state === 'blocked' ? 'QUEUE_BLOCKED' : body.state === 'retry' ? 'QUEUE_RETRY' : '') :\n    status >= 400 && status <= 599 ? 'QUEUE_HTTP_' + status : 'QUEUE_RESPONSE_UNCONFIRMED',\n  wakeWorker: Boolean(valid && ['queued', 'leased', 'retry'].includes(body.state))\n}, pairedItem: {item: 0}}];\n"
