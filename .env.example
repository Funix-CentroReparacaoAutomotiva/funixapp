# Modelo sem credenciais. Configure localmente/cofre; não envie chaves pelo chat.
# Senha local de desenvolvimento (mínimo 12 caracteres). Não é login corporativo.
FUNIX_OPERATOR_PASSWORD=
FUNIX_APP_ORIGIN=http://127.0.0.1:5173
FUNIX_API_PORT=8787
# Desenvolvimento: loopback. O Compose define 0.0.0.0 dentro do contêiner.
FUNIX_API_HOST=127.0.0.1
FUNIX_DATABASE_PATH=.runtime/funix.sqlite

# Receptor M2M fechado por padrão. Nenhuma ativação/captura real autorizada.
FUNIX_WHATSAPP_INGEST_ENABLED=false
# Arquivo privado do backend, fornecido por cofre em futura ativação autorizada.
FUNIX_WHATSAPP_INGEST_CONFIG_FILE=

# Legado isolado: o MVP local não usa estas credenciais nem consulta Coda.
# Somente backend; jamais prefixar com VITE_.
CODA_API_TOKEN=
# IDs de views observados pelo conector; confirmar equivalência na API REST.
# Funil: table-cJ75t2m_-9 ; acompanhamento: table-wqS5r8cTUX.
# O adaptador confere os metadados antes de usar o contrato.
FUNIX_CODA_FUNIL_VIEW_ID=
FUNIX_CODA_ACOMPANHAMENTO_VIEW_ID=

# Backend-only; required for NEW budget emissions. Keep real credentials outside Git.
FUNIX_JSREPORT_ENDPOINT=
FUNIX_JSREPORT_USERNAME=
FUNIX_JSREPORT_PASSWORD=
FUNIX_JSREPORT_TEMPLATE=FUNIX - Orcamento

# Copiloto PR2: somente backend, sem aplicação de alterações.
# Configure a chave somente por cofre/runtime da implantação; testes usam mocks.
OPENAI_API_KEY=
FUNIX_VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
FUNIX_VOICE_INTERPRETATION_MODEL=gpt-6.1-terra
# Somente backend: log agregado de duração/tokens/status, SEM áudio/transcrição/IDs; desativado por padrão.
FUNIX_VOICE_USAGE_ENABLED=false
# Experimento reversível. Ausente mantém esforço padrão atual; habilitar somente após autorização.
# FUNIX_VOICE_REASONING_EFFORT=low
# Diagnóstico de custo, somente metadados fixos de tamanho/contagem de prompt; desligado por padrão.
# Não contém transcrição, catálogo, IDs ou texto do contexto. Sem alterar request ou modelo.
# FUNIX_VOICE_FOOTPRINT_ENABLED=true
# Piloto reversível: remove somente as regras de recomendação do contexto enviado ao modelo.
# O planejador continua recebendo o contexto completo; padrão é standard.
# Não ativar antes do piloto controlado e da confirmação humana.
# FUNIX_VOICE_CONTEXT_MODE=omit_recommendations

# Cotação via web_search — opt-in no backend; não habilita automaticamente.
# Limite global por ledger: dez tentativas. Padrão: diretório do banco FUNIX_DATABASE_PATH.
FUNIX_QUOTE_ENABLED=false
# Backend-only aggregate diagnostic logs, disabled by default.
FUNIX_QUOTE_METRICS_ENABLED=false
# Experimental focused search with medium context (backend-only, default OFF).
FUNIX_QUOTE_DISCOVERY_V2=false
# Independent opt-in: saved diagnosis component search next to MR (default OFF).
FUNIX_DIAGNOSIS_QUOTE_ENABLED=false
# FUNIX_QUOTE_LEDGER=/caminho/absoluto/persistente/funix-quote-pilot-ledger.json
